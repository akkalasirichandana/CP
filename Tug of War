#include <bits/stdc++.h>
using namespace std;
int n;
vector<int> a;
int total;
int ans = INT_MAX;
void solve(int index, int count, int sum) {
    if (index == n) {
        int other = total - sum;
        if (abs(count - (n - count)) <= 1) {
            ans = min(ans, abs(sum - other));
        }
        return;
    }
    solve(index + 1, count + 1, sum + a[index]);
    solve(index + 1, count, sum);
}
int main() {
    cin >> n;
    a.resize(n);
    total = 0;
    for (int i = 0; i < n; i++) {
        cin >> a[i];
        total += a[i];
    }
    solve(0, 0, 0);
    cout << ans << '\n';
    return 0;
}


