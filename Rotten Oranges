#include <bits/stdc++.h>
using namespace std;
int main() {
    int N, M;
    cin >> N >> M;
    vector<vector<int>> grid(N, vector<int>(M));
    queue<pair<int, int>> q;
    int fresh = 0;
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < M; j++) {
            cin >> grid[i][j];
            if (grid[i][j] == 2) {
                q.push({i, j});
            }
            else if (grid[i][j] == 1) {
                fresh++;
            }
        }
    }
   if (fresh == 0) {
        cout << 0;
        return 0;
    }
    int time = 0;
    int dr[] = {-1, 1, 0, 0};
    int dc[] = {0, 0, -1, 1};
    while (!q.empty()) {
        int size = q.size();
        bool changed = false;
        for (int i = 0; i < size; i++) {
            int r = q.front().first;
            int c = q.front().second;
            q.pop();
            for (int d = 0; d < 4; d++) {
                int nr = r + dr[d];
                int nc = c + dc[d];
                if (nr >= 0 && nr < N &&
                    nc >= 0 && nc < M &&
                    grid[nr][nc] == 1) {
                    grid[nr][nc] = 2;
                    fresh--;
                    q.push({nr, nc});
                    changed = true;
                }
            }
        }
        if (changed) {
            time++;
        }
    }
    if (fresh > 0)
        cout << -1;
    else
        cout << time;
    return 0;
}
