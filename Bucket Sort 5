#include <iostream>
#include <vector>
#include <algorithm>
#include <iomanip>
using namespace std;
int main() {
    int N;
    cin >> N;
    vector<double> arr(N);
    bool decimal = false;
    for (int i = 0; i < N; i++) {
        cin >> arr[i];
        if (arr[i] != (int)arr[i])
            decimal = true;
    }
    sort(arr.begin(), arr.end());
    if (decimal)
        cout << fixed << setprecision(2);
    for (int i = 0; i < N; i++) {
        if (decimal)
            cout << arr[i];
        else
            cout << (int)arr[i];
        if (i != N - 1)
            cout << " ";
    }
    return 0;
}
