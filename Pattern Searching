#include <iostream>
#include <vector>
#include <string>
using namespace std;
vector<int> buildLPS(string pat) {
    int m = pat.length();
    vector<int> lps(m, 0);
    int len = 0;
    int i = 1;
    while (i < m) {
        if (pat[i] == pat[len]) {
            len++;
            lps[i] = len;
            i++;
        }
        else {
            if (len != 0) {
                len = lps[len - 1];
            }
            else {
                lps[i] = 0;
                i++;
            }
        }
    }
    return lps;
}
void search(string pat, string txt) {
    int n = txt.length();
    int m = pat.length();
    vector<int> lps = buildLPS(pat);
    int i = 0;  
    int j = 0;  
    while (i < n) {
        if (txt[i] == pat[j]) {
            i++;
            j++;
        }
        if (j == m) {
            cout << i - j << endl;
            j = lps[j - 1];
        }
        else if (i < n && txt[i] != pat[j]) {
            if (j != 0) {
                j = lps[j - 1];
            }
            else {
                i++;
            }
        }
    }
}
int main() {
    string txt, pat;
    getline(cin, txt);
    getline(cin, pat);
    search(pat, txt);
    return 0;
}
