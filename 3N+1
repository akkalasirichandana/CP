#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;
int cycle_length(long long n){
    int count=1;
    while(n!=1){
        if(n%2==0)
           n=n/2;
        else
           n=3*n+1;
    count++;
    }
    return count;
}
int main() {
    int i,j;
    cin>>i>>j;
    int start=min(i,j);
    int end=max(i,j);
    int maxcycle=0;
    for(int k=start ; k<=end ; k++){
        maxcycle=max(maxcycle,cycle_length(k));
    }   
    cout<<i<<" "<<j<<" "<<maxcycle<<endl;
    return 0;
}
